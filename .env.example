# Pick any tool-calling chat model as "provider:model", and set that provider's key.
# Leave AGENT_MODEL empty to run on the offline stub.
AGENT_MODEL=openai:gpt-4.1
# AGENT_MODEL=mistralai:mistral-large-latest
# AGENT_MODEL=anthropic:<model-name>
# AGENT_MODEL=google_genai:gemini-3.6-flash
# AGENT_MODEL=ollama:llama3.1          # local model (pip install langchain-ollama)

JUDGE_MODEL=                           # optional: a different, ideally stronger model for judging

OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# FORCE_OFFLINE=true   # demo without network
